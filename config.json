{
  "bank_root": "bank",
  "retrieval": {
    "default_mode": "standard",
    "modes": {
      "light":  {"expand_top": 0, "title_scan": 300},
      "standard": {"expand_top": 3, "title_scan": 500},
      "rigorous": {"expand_top": 10, "title_scan": 1200}
    },
    "max_results": 20,
    "archive_after_months": 6,
    "hit_threshold_archive": 0
  },
  "consolidate": {
    "llm": {
      "provider": "deepseek",
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-chat",
      "env_key": "DEEPSEEK_API_KEY"
    },
    "llm_window_days": 7,
    "weekly_target": 50,
    "pattern_threshold": 3,
    "stale_updated_days": 90,
    "stale_read_days": 60
  },
  "daemon": {
    "port": 8123,
    "preload_max_lines": 200,
    "preload_recent_days": 7
  },
  "synthesize": {
    "llm": {
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-chat",
      "env_key": "DEEPSEEK_API_KEY",
      "max_tokens": 2000
    }
  },
  "feishu": {
    "app_id": "",
    "app_secret": "",
    "chat_id": "",
    "base_url": "https://open.feishu.cn/open-apis"
  }
}
